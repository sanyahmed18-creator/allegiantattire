# ===== CloudPool provider credentials =====
# Copy this file to .env and fill in the credentials for the providers you want.
# Any provider left blank simply shows as "not configured" in the app.

# --- Google Drive ---
# 1. Go to https://console.cloud.google.com/ -> create a project
# 2. Enable the "Google Drive API"
# 3. OAuth consent screen -> External -> add yourself as a test user
# 4. Credentials -> Create OAuth Client ID -> Web application
# 5. Add redirect URI:  <YOUR_APP_URL>/api/auth/googledrive/callback
#    (e.g. http://localhost:4000/api/auth/googledrive/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Dropbox ---
# 1. Go to https://www.dropbox.com/developers/apps -> Create app
# 2. Choose "Scoped access" + "Full Dropbox" (or App folder)
# 3. Permissions tab: enable files.content.write, files.content.read,
#    files.metadata.read, account_info.read
# 4. Add redirect URI:  <YOUR_APP_URL>/api/auth/dropbox/callback
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

# --- OneDrive (Microsoft Graph) ---
# 1. Go to https://portal.azure.com -> Microsoft Entra ID -> App registrations -> New
# 2. Supported account types: "Personal Microsoft accounts and org accounts"
# 3. Add redirect URI (Web):  <YOUR_APP_URL>/api/auth/onedrive/callback
# 4. Certificates & secrets -> New client secret
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Port for the server
PORT=4000

# Optional: force the public base URL used in OAuth redirects.
# If unset, it is auto-detected from the incoming request.
# BASE_URL=http://localhost:4000
